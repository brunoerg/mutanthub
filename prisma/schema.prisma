// MutantHub database schema.
//
// Design notes
// - A Mutant always points to a Revision (an exact commit). The fingerprint
//   (project + revision + file + start line + normalized original/mutated
//   code) is the duplicate-detection key; a line number only identifies a
//   location together with its revision.
// - Moderation state (reviewStatus) and experimental outcome (mutationStatus)
//   are independent. Every transition is appended to MutantStatusHistory.
// - Commands stored on Submission / Validation are evidence only. They are
//   never executed by the server.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GlobalRole {
  USER
  ADMIN
}

enum ProjectRole {
  CONTRIBUTOR
  REVIEWER
  MAINTAINER
}

enum MutationOperator {
  ARITHMETIC_OPERATOR
  RELATIONAL_OPERATOR
  CONDITIONAL_OPERATOR
  LOGICAL_OPERATOR
  CONSTANT_REPLACEMENT
  RETURN_VALUE
  STATEMENT_DELETION
  FUNCTION_CALL
  CUSTOM
  UNKNOWN
}

enum ReviewStatus {
  PENDING
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  DUPLICATE
  WITHDRAWN
}

enum MutationStatus {
  UNKNOWN
  SURVIVED
  KILLED
  EQUIVALENT
  INVALID
}

enum ValidationResult {
  SURVIVED
  KILLED
  COULD_NOT_REPRODUCE
}

enum ObservedResult {
  SURVIVED
  KILLED
  UNKNOWN
}

enum StatusKind {
  REVIEW
  MUTATION
  /// A contributor edited the submission (fields listed in `comment`).
  SUBMISSION
}

enum ActivityType {
  MUTANT_SUBMITTED
  MUTANT_APPROVED
  MUTANT_REJECTED
  MUTANT_NEEDS_INFORMATION
  MUTANT_MARKED_DUPLICATE
  MUTANT_REPRODUCED
  MUTANT_KILLED
  MUTANT_MARKED_EQUIVALENT
  MUTANT_MARKED_INVALID
  MUTANT_STATUS_CHANGED
  COMMENT_ADDED
  MUTANT_EDITED
  MUTANT_WITHDRAWN
  MUTANT_RESUBMITTED
  KILL_CLAIMED
  KILL_VERIFIED
  KILL_REFUTED
  MUTANTS_IMPORTED
  MUTANT_DRIFTED
}

/// Whether a mutant's original code is still where it was, on the project's default branch.
enum DriftStatus {
  UNCHECKED
  APPLIES
  MOVED
  GONE
}

// ---------------------------------------------------------------------------
// Users (sessions are stateless JWTs; GitHub identity is stored on the user)
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(cuid())
  githubId       String?    @unique
  /// Case-insensitive, like GitHub; stores GitHub's casing.
  githubUsername String     @unique @db.Citext
  displayName    String
  avatarUrl      String?
  email          String?    @unique
  globalRole     GlobalRole @default(USER)
  bio            String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Domain relations
  memberships   ProjectMember[]
  follows       ProjectFollow[]
  mutants       Mutant[]              @relation("MutantCreatedBy")
  submissions   Submission[]
  validations   Validation[]
  comments      Comment[]
  statusChanges MutantStatusHistory[]
  activities    Activity[]
  notifications Notification[]        @relation("NotificationRecipient")
  triggered     Notification[]        @relation("NotificationActor")
  auditEntries  AuditLog[]
  snapshots     DatasetSnapshot[]
  imports       ImportBatch[]
  killClaims    KillClaim[]           @relation("KillClaimClaimedBy")
  killVerdicts  KillClaim[]           @relation("KillClaimResolvedBy")
  addedProjects Project[]             @relation("ProjectAddedBy")

  @@index([globalRole])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id                 String   @id @default(cuid())
  githubOwner        String
  githubRepository   String
  githubRepositoryId String?  @unique
  displayName        String
  description        String?
  defaultBranch      String   @default("main")
  language           String?
  isActive           Boolean  @default(true)
  addedById          String?
  /// Last drift check against the default branch (see driftStatus on mutants).
  driftCheckedAt     DateTime?
  driftCommitSha     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  addedBy       User?           @relation("ProjectAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  followers     ProjectFollow[]
  revisions     Revision[]
  mutants       Mutant[]
  activities    Activity[]
  notifications Notification[]
  pullRequests  PullRequest[]
  imports       ImportBatch[]

  @@unique([githubOwner, githubRepository])
  @@index([isActive])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectFollow {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// An exact Git commit of a project. Mutants always reference a Revision.
model Revision {
  id            String    @id @default(cuid())
  projectId     String
  commitSha     String
  branch        String?
  commitMessage String?
  author        String?
  commitDate    DateTime?
  createdAt     DateTime  @default(now())

  /// Set when this commit was the head of a tracked pull request.
  pullRequestId String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  mutants     Mutant[]

  @@unique([projectId, commitSha])
  @@index([pullRequestId])
}

// ---------------------------------------------------------------------------
// Mutants
// ---------------------------------------------------------------------------

model Mutant {
  id               Int              @id @default(autoincrement())
  projectId        String
  revisionId       String
  filePath         String
  startLine        Int
  endLine          Int
  originalCode     String
  mutatedCode      String
  gitDiff          String
  mutationOperator MutationOperator @default(UNKNOWN)
  title            String
  description      String?
  fingerprint      String
  reviewStatus     ReviewStatus     @default(PENDING)
  mutationStatus   MutationStatus   @default(UNKNOWN)
  duplicateOfId    Int?
  /// Set when the mutant was submitted in the context of a pull request.
  pullRequestId    String?
  /// Provenance for bulk imports: the batch, the tool, and the tool's own mutant id.
  /// Result of the last drift check: is originalCode still at startLine on the default branch?
  driftStatus    DriftStatus @default(UNCHECKED)
  driftCheckedAt DateTime?
  driftCommitSha String?
  /// Line where the original code was found when MOVED.
  driftLine      Int?
  importBatchId    String?
  toolName         String?
  externalId       String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision      Revision              @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("MutantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  duplicateOf   Mutant?               @relation("MutantDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Mutant[]              @relation("MutantDuplicates")
  pullRequest   PullRequest?          @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  submissions   Submission[]
  validations   Validation[]
  comments      Comment[]
  statusHistory MutantStatusHistory[]
  activities    Activity[]
  notifications Notification[]
  killClaims    KillClaim[]

  @@index([projectId, filePath])
  @@index([revisionId, filePath, startLine])
  @@index([fingerprint])
  @@index([reviewStatus])
  @@index([mutationStatus])
  @@index([createdById])
  @@index([createdAt])
  @@index([pullRequestId])
  @@index([importBatchId])
  @@index([projectId, driftStatus])
}

/// How the submitter tested the mutant. Commands are stored as text only.
model Submission {
  id                     String         @id @default(cuid())
  mutantId               Int
  submittedById          String
  buildCommand           String?
  testCommand            String
  fuzzCommand            String?
  testDurationSeconds    Int?
  environmentDescription String?
  operatingSystem        String?
  compiler               String?
  observedResult         ObservedResult @default(UNKNOWN)
  notes                  String?
  stdout                 String?
  stderr                 String?
  createdAt              DateTime       @default(now())

  mutant      Mutant @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  submittedBy User   @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([mutantId])
  @@index([submittedById])
}

/// A reproduction attempt by another user.
model Validation {
  id             String           @id @default(cuid())
  mutantId       Int
  userId         String
  result         ValidationResult
  command        String?
  environment    String?
  notes          String?
  /// Reference to the test that kills the mutant (URL, PR, or test path). Text only.
  killingTestRef String?
  /// Commit the reproduction was run against, when it differs from the mutant's revision.
  commitSha      String?
  /// Set when the reproduction verifies (or refutes) a kill claim.
  killClaimId    String?
  killClaim      KillClaim?       @relation(fields: [killClaimId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  mutant Mutant @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mutantId])
  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  mutantId  Int
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mutant Mutant @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mutantId, createdAt])
  @@index([userId])
}

/// Append-only log of review/mutation status transitions.
model MutantStatusHistory {
  id            String     @id @default(cuid())
  mutantId      Int
  changedById   String?
  kind          StatusKind
  previousValue String?
  newValue      String
  comment       String?
  createdAt     DateTime   @default(now())

  mutant    Mutant @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([mutantId, createdAt])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  actorId   String?
  projectId String?
  mutantId  Int?
  payload   Json?
  createdAt DateTime     @default(now())

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mutant  Mutant?  @relation(fields: [mutantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([mutantId])
}

/// Per-recipient inbox entry derived from an Activity event.
model Notification {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  actorId   String?
  mutantId  Int?
  projectId String?
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  mutant  Mutant?  @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([mutantId])
}

enum AuditAction {
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  PROJECT_ACTIVATED
  PROJECT_DEACTIVATED
  PROJECT_REFRESHED
  PROJECT_REGISTERED
  MUTANT_REVIEWED
  MUTANT_CLASSIFIED
  DATASET_PUBLISHED
  MUTANTS_IMPORTED
  DRIFT_CHECKED
}

/// Append-only record of privileged actions (membership, project state, moderation).
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  projectId  String?
  targetType String
  targetId   String
  /// Structured details (previous/new role, statuses, usernames). Never contains secrets.
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

/// A tracked GitHub pull request. Mutants can be scoped to it; each head
/// commit becomes a Revision so drift across PR updates is preserved.
model PullRequest {
  id            String           @id @default(cuid())
  projectId     String
  number        Int
  title         String
  authorLogin   String?
  state         PullRequestState @default(OPEN)
  baseRef       String
  baseSha       String
  headRef       String
  headSha       String
  htmlUrl       String
  /// Changed line ranges in the head commit, per file: { "path": [[start, end], ...] }.
  changedRanges Json
  changedFiles  Int              @default(0)
  additions     Int              @default(0)
  deletions     Int              @default(0)
  /// GitHub check run id for the latest report, when the app can post checks.
  checkRunId    String?
  checkRunAt    DateTime?
  lastSyncedAt  DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions  Revision[]
  mutants    Mutant[]
  killClaims KillClaim[]

  @@unique([projectId, number])
  @@index([projectId, state, updatedAt])
}

/// A frozen, citable export of mutants. The rows are stored as published so
/// later status changes never alter a snapshot; the hash makes it verifiable.
model DatasetSnapshot {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Filters used to select the rows (same keys as the public list API).
  filters     Json
  rowCount    Int
  /// SHA-256 of the canonical JSON rows.
  contentHash String
  /// The published rows (ExportRow[]), frozen at creation time.
  data        Json
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum KillClaimKind {
  PULL_REQUEST
  COMMIT
  TEST_PATH
}

enum KillClaimStatus {
  CLAIMED
  VERIFIED
  REFUTED
  STALE
}

/// Whether the mutant's original code still exists at the verification commit.
enum KillClaimApplies {
  UNKNOWN
  APPLIES
  MOVED
  NOT_FOUND
}

/// "PR #123 adds a test that kills this mutant": a structured, verifiable claim.
model KillClaim {
  id              String            @id @default(cuid())
  mutantId        Int
  claimedById     String
  kind            KillClaimKind
  /// PR number, commit SHA or test path, depending on `kind`.
  reference       String
  note            String?
  status          KillClaimStatus   @default(CLAIMED)
  pullRequestId   String?
  /// Snapshot of the PR state at the last refresh.
  prState         PullRequestState?
  prTouchesTests  Boolean?
  /// Commit at which the claim is verified: merge commit, PR head, or the given commit.
  verifyCommitSha String?
  applies         KillClaimApplies  @default(UNKNOWN)
  /// Line where the original code was found at the verification commit.
  appliesLine     Int?
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNote  String?
  lastCheckedAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  mutant      Mutant       @relation(fields: [mutantId], references: [id], onDelete: Cascade)
  claimedBy   User         @relation("KillClaimClaimedBy", fields: [claimedById], references: [id], onDelete: Cascade)
  resolvedBy  User?        @relation("KillClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)
  validations Validation[]

  @@index([mutantId, createdAt])
  @@index([pullRequestId])
  @@index([status])
}

/// One bulk import of tool-generated mutants (admin only, created as approved).
model ImportBatch {
  id           String   @id @default(cuid())
  projectId    String
  importedById String?
  toolName     String
  toolVersion  String?
  fileName     String?
  rowCount     Int
  createdCount Int
  skippedCount Int
  errorCount   Int
  /// Per-row outcome details (errors and skipped duplicates) for the report page.
  report       Json
  createdAt    DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importedBy User?    @relation(fields: [importedById], references: [id], onDelete: SetNull)
  mutants    Mutant[]

  @@index([projectId, createdAt])
}
